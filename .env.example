# Optional — only needed if you run the server/index.js AI proxy
# to power the assistant with a real Claude model instead of the
# built-in offline rule-based engine.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
PORT=8787

# Optional — only needed on the frontend if you're using the server proxy.
# Copy this to a real .env file at the project root (Vite auto-loads it).
# If left unset, the site uses the local offline assistant automatically.
VITE_AI_ENDPOINT=http://localhost:8787/api/ask
